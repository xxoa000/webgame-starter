# ----------------------------------------------------------------- MySQL
# MYSQL_ROOT_PASSWORD 는 DB 전체를 관리하는 관리자(개발용) 계정.
# MYSQL_PASSWORD 는 웹게임 DB 만 관리하는 운영용 계정.
MYSQL_ROOT_PASSWORD=replace-with-root-password
MYSQL_PASSWORD=replace-with-app-password
MYSQL_PORT=3308


# ----------------------------------------------------------------- FRONT
FRONTEND_PORT=5174
FRONTEND_ORIGIN=http://localhost:5174


# ----------------------------------------------------------------- BACK
BACKEND_PORT=8001
NEXT_PUBLIC_API_URL=http://localhost:8001


# ----------------------------------------------------------------- JWT Token
COOKIE_SECURE=false
JWT_SECRET_KEY=생성한_값
JWT_ACCESS_HOURS=24   